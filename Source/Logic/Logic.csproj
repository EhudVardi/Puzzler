<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10.0-windows temporarily because Common (a dependency) still carries -->
    <!-- a WinForms ref. Reverts to net10.0 in Phase 3 when Common is cleaned up. -->
    <TargetFramework>net10.0-windows</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!-- Replaces the vendored Libraries/Combinatorics project. NuGet package ID is -->
    <!-- "Combinatorics" (by Adrian Akison); v2+ namespace is Combinatorics.Collections. -->
    <PackageReference Include="Combinatorics" Version="*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Common\Common.csproj" />
    <ProjectReference Include="..\Data\Data.csproj" />
  </ItemGroup>

</Project>
