<UserControl Name="PuzzlerDataGrid"
             x:Class="Presentation.WPF.ucPuzzlerDataGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Presentation.WPF"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">

    <UserControl.Resources>
        <Style x:Key="DarkColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background"  Value="#16162A"/>
            <Setter Property="Foreground"  Value="#E0E0F0"/>
            <Setter Property="BorderBrush" Value="#3A3A50"/>
            <Setter Property="Padding"     Value="6,4"/>
        </Style>
        <Style x:Key="DarkRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="#252538"/>
            <Setter Property="Foreground" Value="#E0E0F0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#7C6AF7"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3A3A50"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DarkCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <ControlTemplate x:Key="DarkThumbTemplate" TargetType="Thumb">
            <Border x:Name="ThumbBorder" Background="#3A3A50" CornerRadius="3" Margin="2"/>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="ThumbBorder" Property="Background" Value="#5A5A72"/>
                </Trigger>
                <Trigger Property="IsDragging" Value="True">
                    <Setter TargetName="ThumbBorder" Property="Background" Value="#7C6AF7"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#16162A"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Template="{StaticResource DarkThumbTemplate}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="10"/>
                    <Setter Property="MinHeight" Value="10"/>
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="{TemplateBinding Background}">
                                    <Track x:Name="PART_Track">
                                        <Track.Thumb>
                                            <Thumb Template="{StaticResource DarkThumbTemplate}"/>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Visible">
            <DataGrid x:Name="datagrid" Margin="5" AutoGenerateColumns="False" IsReadOnly="True"
                      MouseDoubleClick="datagrid_MouseDoubleClick" PreviewKeyDown="datagrid_PreviewKeyDown"
                      Background="#252538"
                      Foreground="#E0E0F0"
                      BorderBrush="#3A3A50"
                      RowBackground="#252538"
                      AlternatingRowBackground="#2A2A3C"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#3A3A50"
                      ColumnHeaderStyle="{StaticResource DarkColumnHeaderStyle}"
                      RowStyle="{StaticResource DarkRowStyle}"
                      CellStyle="{StaticResource DarkCellStyle}"
                      RowHeaderWidth="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding Name}" Header="Name"/>
                    <DataGridTextColumn Binding="{Binding Path}" Header="Path" Visibility="Collapsed"/>
                </DataGrid.Columns>
            </DataGrid>
        </ScrollViewer>
    </Grid>

</UserControl>
