<Window x:Class="Presentation.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:UserControls="clr-namespace:Presentation.WPF"
        Title="Solvers"
        Loaded="Window_Loaded"
        MouseDown="Window_MouseDown"
        MouseMove="Window_MouseMove"
        MouseUp="Window_MouseUp"
        MouseWheel="Window_MouseWheel"
        KeyDown="Window_KeyDown"
        Width="800" Height="600" ResizeMode="CanResize" UseLayoutRounding="True" WindowStyle="None"
        Background="#1E1E2E" FontFamily="Segoe UI" FontSize="12">
    <Window.Resources>
        <!-- Flat dark palette -->
        <SolidColorBrush x:Key="AppBackgroundBrush"      Color="#1E1E2E"/>
        <SolidColorBrush x:Key="SurfaceBrush"            Color="#252538"/>
        <SolidColorBrush x:Key="ChromeBrush"             Color="#16162A"/>
        <SolidColorBrush x:Key="AccentBrush"             Color="#7C6AF7"/>
        <SolidColorBrush x:Key="PanelBorderBrush"        Color="#3A3A50"/>
        <SolidColorBrush x:Key="ForegroundBrush"         Color="#E0E0F0"/>
        <SolidColorBrush x:Key="MutedForegroundBrush"    Color="#6B6B8A"/>

        <!-- Kept for inline references elsewhere -->
        <SolidColorBrush x:Key="MainPanelsBrush"         Color="#252538"/>

        <!-- Legacy brush keys re-mapped to flat equivalents -->
        <SolidColorBrush x:Key="BorderPanelsBrushTitleBar"   Color="#16162A"/>
        <SolidColorBrush x:Key="BorderPanelsBrushStatusBar"  Color="#16162A"/>
        <SolidColorBrush x:Key="BorderPanelsBrushTop"        Color="#16162A"/>
        <SolidColorBrush x:Key="BorderPanelsBrushBottom"     Color="#16162A"/>
        <SolidColorBrush x:Key="BorderPanelsBrushLeft"       Color="#16162A"/>
        <SolidColorBrush x:Key="BorderPanelsBrushRight"      Color="#16162A"/>
        <SolidColorBrush x:Key="BorderPanelsBrushMainGrid"   Color="#1E1E2E"/>
        <SolidColorBrush x:Key="BorderPanelsBrushExitButton" Color="#4A1F1F"/>

        <!-- Implicit dark-theme foreground for standard controls -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground"                 Value="{StaticResource MutedForegroundBrush}"/>
            <Setter Property="Background"                 Value="Transparent"/>
            <Setter Property="BorderBrush"                Value="{StaticResource PanelBorderBrush}"/>
            <Setter Property="BorderThickness"            Value="1"/>
            <Setter Property="Padding"                    Value="8,4"/>
            <Setter Property="Margin"                     Value="0,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor"                     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background"  Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked"   Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background"  Value="{StaticResource PanelBorderBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground"      Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource PanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- outer border -->
                            <Border Grid.RowSpan="2"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"/>
                            <!-- inner border — dimmed, creates the double-line -->
                            <Border Grid.RowSpan="2"
                                    Margin="2"
                                    BorderBrush="#505068"
                                    BorderThickness="1"
                                    CornerRadius="3"/>
                            <!-- header clips through both borders -->
                            <Border Grid.Row="0"
                                    HorizontalAlignment="Left"
                                    Background="{StaticResource SurfaceBrush}"
                                    Margin="8,-1,0,0"
                                    Padding="4,0">
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                            </Border>
                            <ContentPresenter Grid.Row="1" Margin="{TemplateBinding Padding}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background"  Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground"  Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding"    Value="6,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource PanelBorderBrush}"
                                BorderThickness="1,1,1,0"
                                CornerRadius="4,4,0,0"
                                Margin="2,2,2,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background"    Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush"   Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected"  Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource PanelBorderBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground"      Value="{StaticResource AccentBrush}"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderBrush"     Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="10,5"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#227C6AF7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#447C6AF7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource MutedForegroundBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="StatusBar">
            <Setter Property="Background"  Value="Transparent"/>
            <Setter Property="Foreground"  Value="{StaticResource MutedForegroundBrush}"/>
            <Setter Property="FontSize"    Value="10"/>
        </Style>
        <Style TargetType="StatusBarItem">
            <Setter Property="Foreground"  Value="{StaticResource MutedForegroundBrush}"/>
            <Setter Property="FontSize"    Value="10"/>
        </Style>

        <!-- Named styles (keys unchanged so XAML references still resolve) -->
        <Style x:Key="BorderPanelsStyleTitleBar" TargetType="DockPanel">
            <Setter Property="Background" Value="{StaticResource BorderPanelsBrushTitleBar}"/>
        </Style>
        <Style x:Key="BorderPanelsStyleStatusBar" TargetType="DockPanel">
            <Setter Property="Background" Value="{StaticResource BorderPanelsBrushStatusBar}"/>
        </Style>
        <Style x:Key="BorderPanelsStyleTop" TargetType="DockPanel">
            <Setter Property="Background" Value="{StaticResource BorderPanelsBrushTop}"/>
        </Style>
        <Style x:Key="BorderPanelsStyleBottom" TargetType="DockPanel">
            <Setter Property="Background" Value="{StaticResource BorderPanelsBrushBottom}"/>
        </Style>
        <Style x:Key="BorderPanelsStyleLeft" TargetType="DockPanel">
            <Setter Property="Background" Value="{StaticResource BorderPanelsBrushLeft}"/>
        </Style>
        <Style x:Key="BorderPanelsStyleRight" TargetType="DockPanel">
            <Setter Property="Background" Value="{StaticResource BorderPanelsBrushRight}"/>
        </Style>
        <Style x:Key="BorderPanelsStyleMainGrid" TargetType="Grid">
            <Setter Property="Background" Value="{StaticResource BorderPanelsBrushMainGrid}"/>
        </Style>
        <Style x:Key="BorderPanelsStyleAppTitle" TargetType="TextBlock">
            <Setter Property="Background"  Value="Transparent"/>
            <Setter Property="Foreground"  Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="FontStyle"   Value="Italic"/>
            <Setter Property="FontSize"    Value="18"/>
            <Setter Property="FontStretch" Value="Expanded"/>
            <Setter Property="Text"        Value=" Puzzler"/>
        </Style>
        <Style x:Key="BorderPanelsStyleExitButton" TargetType="Button">
            <Setter Property="Background"  Value="{StaticResource BorderPanelsBrushExitButton}"/>
            <Setter Property="Foreground"  Value="{StaticResource ForegroundBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize"   Value="14"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#6B2F2F"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="4,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#6B2F2F"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#8B3F3F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BorderPanelsStyleAppSignature" TargetType="TextBlock">
            <Setter Property="Background"                    Value="Transparent"/>
            <Setter Property="Foreground"                    Value="{StaticResource MutedForegroundBrush}"/>
            <Setter Property="FontWeight"                    Value="Light"/>
            <Setter Property="FontStyle"                     Value="Italic"/>
            <Setter Property="FontSize"                      Value="9"/>
            <Setter Property="FontStretch"                   Value="UltraExpanded"/>
            <Setter Property="FontFamily"                    Value="Vivaldi"/>
            <Setter Property="Text"                          Value="Ehud Vardi"/>
            <Setter Property="TextAlignment"                 Value="Center"/>
            <Setter Property="VerticalAlignment"             Value="Center"/>
            <Setter Property="HorizontalAlignment"           Value="Center"/>
            <Setter Property="TextBlock.VerticalAlignment"   Value="Center"/>
            <Setter Property="TextBlock.HorizontalAlignment" Value="Right"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="7"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="7"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="7"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="25"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="25"></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Row="1" Grid.Column="1" Margin="2" Style="{StaticResource ResourceKey=BorderPanelsStyleMainGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                    <ColumnDefinition Width="200"></ColumnDefinition>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Margin="5" Background="{StaticResource SurfaceBrush}"
                        CornerRadius="8" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" Padding="4">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.35" BlurRadius="10" ShadowDepth="2" Direction="315"/>
                    </Border.Effect>
                    <StackPanel>
                        <GroupBox Header="Puzzle Type" Margin="3" VerticalAlignment="Top">
                            <DockPanel>
                                <RadioButton x:Name="btnSelectSudoku"   DockPanel.Dock="Top" Content="Sudoku"   Checked="btnSelectPuzzles_Checked"/>
                                <RadioButton x:Name="btnSelectKakuru"   DockPanel.Dock="Top" Content="Kakuru"   Checked="btnSelectPuzzles_Checked"/>
                                <RadioButton x:Name="btnSelectGriddler" DockPanel.Dock="Top" Content="Griddler" Checked="btnSelectPuzzles_Checked"/>
                                <RadioButton x:Name="btnSelectTriddler" DockPanel.Dock="Top" Content="Triddler" Checked="btnSelectPuzzles_Checked"/>
                            </DockPanel>
                        </GroupBox>
                        <GroupBox Header="Display" Margin="3" VerticalAlignment="Top">
                            <DockPanel>
                                <RadioButton x:Name="rbtnClean"  DockPanel.Dock="Top" Content="Clean"  IsChecked="True" Checked="rbtnDisplayModes_Checked"/>
                                <RadioButton x:Name="rbtnHints"  DockPanel.Dock="Top" Content="Hints"  Checked="rbtnDisplayModes_Checked"/>
                                <RadioButton x:Name="rbtnSolved" DockPanel.Dock="Top" Content="Solved" Checked="rbtnDisplayModes_Checked"/>
                            </DockPanel>
                        </GroupBox>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Margin="5" Background="{StaticResource SurfaceBrush}"
                        CornerRadius="8" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" Padding="4">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.35" BlurRadius="10" ShadowDepth="2" Direction="315"/>
                    </Border.Effect>
                    <GroupBox Header="Library" VerticalAlignment="Stretch">
                        <TabControl VerticalAlignment="Stretch" Background="{StaticResource SurfaceBrush}">
                            <TabItem Header="Generator">
                                <DockPanel>
                                    <Button x:Name="btnRandom" Margin="10,5" DockPanel.Dock="Top" Content="Generate New Puzzle" Click="btnRandom_Click"/>
                                    <UserControls:ucPuzzlerDataGrid x:Name="ucDataGridGenerator"/>
                                </DockPanel>
                            </TabItem>
                            <TabItem Header="Text">
                                <DockPanel>
                                    <Button x:Name="btnLoadFromText" Margin="10,5" DockPanel.Dock="Top" Content="Read New From Text" Click="btnLoadFromText_Click"/>
                                    <UserControls:ucPuzzlerDataGrid x:Name="ucDataGridText"/>
                                </DockPanel>
                            </TabItem>
                            <TabItem Header="Web">
                                <DockPanel>
                                    <Button x:Name="btnLoadFromWeb" Margin="10,5" DockPanel.Dock="Top" Content="Read New From Web" Click="btnLoadFromWeb_Click"/>
                                    <UserControls:ucPuzzlerDataGrid x:Name="ucDataGridWeb"/>
                                </DockPanel>
                            </TabItem>
                        </TabControl>
                    </GroupBox>
                </Border>
                <Border Grid.Column="2" Margin="5" Background="{StaticResource SurfaceBrush}"
                        CornerRadius="8" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.35" BlurRadius="10" ShadowDepth="2" Direction="315"/>
                    </Border.Effect>
                    <UserControls:PuzzlerCanvas x:Name="GameCanvas" Margin="3" Background="Transparent"/>
                </Border>
            </Grid>
            <DockPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="0" Style="{StaticResource ResourceKey=BorderPanelsStyleTitleBar}" PreviewMouseDown="dpnlTitleBar_PreviewMouseDown">
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource ResourceKey=BorderPanelsStyleAppTitle}"/>
                <Button Width="25" Margin="1" Style="{StaticResource ResourceKey=BorderPanelsStyleExitButton}" DockPanel.Dock="Right" HorizontalAlignment="Right" Content="X" x:Name="btnExitApplication"/>
            </DockPanel>
            <DockPanel Grid.Row="2"  Grid.Column="0" Grid.ColumnSpan="3" Margin="0" Style="{StaticResource ResourceKey=BorderPanelsStyleStatusBar}">
                <StatusBar DockPanel.Dock="Left" Background="Transparent">
                    <StatusBarItem>
                        <TextBlock x:Name="lblStatusTitle">Status:</TextBlock>
                        <!--<TextBlock x:Name="lblStatusTitle">Status:</TextBlock>-->
                    </StatusBarItem>
                    <StatusBarItem>
                        <TextBlock x:Name="lblStatus">---Status---</TextBlock>
                    </StatusBarItem>
                    <StatusBarItem>
                    </StatusBarItem>
                </StatusBar>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource ResourceKey=BorderPanelsStyleAppSignature}"/>
            </DockPanel>
        </Grid>
        <DockPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="0" Style="{StaticResource ResourceKey=BorderPanelsStyleTop}"></DockPanel>
        <DockPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0" Style="{StaticResource ResourceKey=BorderPanelsStyleBottom}"></DockPanel>
        <DockPanel Grid.Row="0" Grid.Column="0" Grid.RowSpan="3" Margin="0" Style="{StaticResource ResourceKey=BorderPanelsStyleLeft}"></DockPanel>
        <DockPanel Grid.Row="0" Grid.Column="2" Grid.RowSpan="3" Margin="0" Style="{StaticResource ResourceKey=BorderPanelsStyleRight}"></DockPanel>
    </Grid>
</Window>
